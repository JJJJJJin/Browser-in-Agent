############################
# AutoBrowser (Node/TS/Playwright)
############################

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# logs (must not be committed)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# caches
.cache/
.eslintcache

# test / coverage
coverage/
.nyc_output/

# Playwright artifacts
playwright-report/
test-results/
**/*.trace.zip

# misc
*.tmp
*.swp

# local data store (SQLite)
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# personal profile (kept local — never commit)
profile/

# generated applications (resumes, cover letters, etc. — kept local)
output/
