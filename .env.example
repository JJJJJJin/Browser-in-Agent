# ── Browser-in-Agent MCP — example configuration ───────────────────────────
# Copy to `.env` and fill in. CLI flags (see README) override these.
# NEVER commit your real .env (it is gitignored).

# HTTP server
PORT=7777
# HEADLESS=true            # false to watch the browser; default true

# Browser source (optional) — where the browser binary comes from.
#   playwright  use Playwright's bundled browsers (default)
#   system      drive a system-installed browser; helps with some Playwright
#               fingerprinting signals
# BROWSER_SOURCE=playwright
# SYSTEM_BROWSER=chrome    # chrome | firefox  (only used when BROWSER_SOURCE=system; default chrome)
# SYSTEM_BROWSER_PATH=     # optional: explicit path to the browser executable,
#                          # overrides auto-detection (mac / win / Raspberry Pi OS)

# Vision fallback (optional) — only needed for agents whose own LLM has no
# vision. Provider must be one of: kimi
# VISION_PROVIDER=kimi
# VISION_API_KEY=sk-your-kimi-key-here
# VISION_MODEL=moonshot-v1-8k-vision-preview      # optional override
# VISION_BASE_URL=https://api.moonshot.cn/v1      # optional override

# Workflow guidelines (optional) — directory of *.md playbooks exposed as MCP prompts
# GUIDELINES_DIR=./guidelines

# Logging
# LOG_LEVEL=info           # debug | info | warn | error | silent
# LOG_JSON=true            # emit machine-parseable JSON log lines on stderr
